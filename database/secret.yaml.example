# =====================================================================
# Database (PostgreSQL / MariaDB) — Secret 템플릿 (예시: 모든 민감값은 change-me)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
# ※ CloudBeaver(values-cloudbeaver.yaml)는 Secret 을 사용하지 않습니다
#   (관리자 계정은 최초 접속 시 웹 UI 에서 설정).

# PostgreSQL — values-postgresql.yaml (auth.existingSecret: postgres-secret)
#   POSTGRES_PASSWORD : superuser(postgres) 비밀번호
#   USER_PASSWORD     : 초기 앱 계정(auth.username: app) 비밀번호
#   (REPLICATION_PASSWORD 는 architecture: replication 일 때만 필요)
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: database
type: Opaque
stringData:
  POSTGRES_PASSWORD: 'change-me'
  USER_PASSWORD: 'change-me'
---
# MariaDB — values-mariadb.yaml (auth.existingSecret: mariadb-secret)
#   ROOT_PASSWORD        : root 비밀번호
#   USER_PASSWORD        : 초기 앱 계정(auth.username: app) 비밀번호
#   REPLICATION_PASSWORD : 차트(2.0.3)가 standalone 에서도 참조하므로 키가 반드시 있어야 함
apiVersion: v1
kind: Secret
metadata:
  name: mariadb-secret
  namespace: database
type: Opaque
stringData:
  ROOT_PASSWORD: 'change-me'
  USER_PASSWORD: 'change-me'
  REPLICATION_PASSWORD: 'change-me'
