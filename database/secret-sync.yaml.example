# =====================================================================
# Database (PostgreSQL / MariaDB) — Infisical 동기화 (InfisicalSecret)
# Infisical 프로젝트 "postgres" / "mariadb" (env: prod) 값을 각각 postgres-secret / mariadb-secret Secret 으로 주입합니다.
# 전제: Infisical secrets-operator 설치 + infisical ns 의 infisical-auth-token Secret
#       (infisical/secret.yaml.example 참고)
# 적용: kubectl apply -f secret-sync.yaml.example
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 secrets-operator 최신 버전(마지막 사용 0.11.0)과
#    InfisicalSecret CRD(secrets.infisical.com/v1alpha1) 스펙 변경 여부를 반드시 확인하세요.
# =====================================================================

# PostgreSQL → postgres-secret
apiVersion: secrets.infisical.com/v1alpha1
kind: InfisicalSecret
metadata:
  name: postgres-secret-sync
  namespace: database
spec:
  hostAPI: https://infisical.techbara.dev/api
  resyncInterval: 60
  authentication:
    universalAuth:
      secretsScope:
        projectSlug: "postgres"
        envSlug: "prod"
        secretsPath: "/"
      credentialsRef:
        secretName: infisical-auth-token
        secretNamespace: infisical
  managedKubeSecretReferences:
    - secretName: postgres-secret
      secretNamespace: database
      secretType: Opaque
---
# MariaDB → mariadb-secret
apiVersion: secrets.infisical.com/v1alpha1
kind: InfisicalSecret
metadata:
  name: mariadb-secret-sync
  namespace: database
spec:
  hostAPI: https://infisical.techbara.dev/api
  resyncInterval: 60
  authentication:
    universalAuth:
      secretsScope:
        projectSlug: "mariadb"
        envSlug: "prod"
        secretsPath: "/"
      credentialsRef:
        secretName: infisical-auth-token
        secretNamespace: infisical
  managedKubeSecretReferences:
    - secretName: mariadb-secret
      secretNamespace: database
      secretType: Opaque
