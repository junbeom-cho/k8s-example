# =====================================================================
# myapp — Secret 템플릿 (예시: 모든 민감값은 change-me)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
#
# 이 파일은 "이 서비스가 어떤 키를 필요로 하는지" 문서 역할도 한다.
#   - 키 이름은 Infisical 프로젝트(prod 환경)의 키 이름과 정확히 일치해야 한다.
#   - 방법 1 에서는 InfisicalSecret 이 Secret 을 직접 생성하므로 이 파일을 apply 할 필요가 없다.
#     secret-sync 가 이미 돌고 있는데 change-me 값 그대로 apply 하면 Secret 값이 덮어써진다
#     (다음 resync, 최대 60초 뒤 Infisical 값으로 복구).
#   - pre-commit 훅은 없으므로, 커밋 전에 gitleaks 로 실제 크레덴셜이 없는지 직접 확인한다.
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: myapp-secret
  namespace: myapp
  labels:
    app: myapp
type: Opaque
stringData:
  # TODO: compose 의 environment 중 비밀 값들을 키로 나열
  DB_HOST: "change-me"
  DB_PORT: "5432"
  DB_NAME: "change-me"
  DB_USER: "change-me"
  DB_PASSWORD: "change-me"
  APP_SECRET_KEY: "change-me"
