# =====================================================================
# myapp — Infisical 동기화 (InfisicalSecret)
# Infisical 프로젝트 "myapp" (env: prod) 값을 myapp-secret Secret 으로 주입합니다.
# 전제: Infisical secrets-operator 설치 + infisical ns 의 infisical-auth-token Secret
#       (infisical/secret.yaml.example 참고)
# 적용: kubectl apply -f secret-sync.yaml.example
#
# 사전 준비:
#   1) Infisical 에 projectSlug 와 같은 이름의 프로젝트를 만들고 prod 환경에 키를 등록
#      (키 이름 = secret.yaml.example 의 stringData 키)
#   2) 해당 프로젝트에 머신 아이덴티티(infisical-auth-token) 읽기 권한 부여
#
# 동작 확인:
#   kubectl get infisicalsecret myapp-secret-sync -n myapp -o yaml   # status.conditions
#   kubectl get secret myapp-secret -n myapp -o jsonpath='{.data}' | jq 'keys'
#
# creationPolicy 는 기본값(Orphan): InfisicalSecret 을 지워도 생성된 Secret 은 남는다.
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 secrets-operator 최신 버전(마지막 사용 0.11.0)과
#    InfisicalSecret CRD(secrets.infisical.com/v1alpha1) 스펙 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: secrets.infisical.com/v1alpha1
kind: InfisicalSecret
metadata:
  name: myapp-secret-sync
  namespace: myapp
spec:
  hostAPI: https://infisical.techbara.dev/api
  resyncInterval: 60
  authentication:
    universalAuth:
      secretsScope:
        projectSlug: "myapp" # TODO: Infisical 프로젝트 slug
        envSlug: "prod"
        secretsPath: "/"
      credentialsRef:
        # 머신 아이덴티티 토큰은 infisical 네임스페이스에 있고, 교차 네임스페이스 참조가 가능하다
        secretName: infisical-auth-token
        secretNamespace: infisical
  managedKubeSecretReferences:
    - secretName: myapp-secret
      secretNamespace: myapp
      secretType: Opaque
