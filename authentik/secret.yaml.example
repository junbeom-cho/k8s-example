# =====================================================================
# Authentik — Secret 템플릿 (예시: 모든 민감값은 change-me)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
# authentik-secret — values.yaml 의 authentik.existingSecret.secretName
#   server/worker 파드에 envFrom 으로 통째로 주입되며, 키 이름은 authentik 환경변수
#   형식(AUTHENTIK_섹션__키)입니다. existingSecret 을 쓰면 values.yaml 의 authentik.*
#   값(secret_key, postgresql.*, email.* 등)은 무시되므로 필요한 설정은 여기서 지정합니다.
apiVersion: v1
kind: Secret
metadata:
  name: authentik-secret
  namespace: authentik
type: Opaque
stringData:
  # 필수: 쿠키 서명/고유 ID 용 키 (최초 설치 후 변경 금지). 예: openssl rand -base64 60 | tr -d '\n'
  AUTHENTIK_SECRET_KEY: "change-me"
  # 필수: 외부 PostgreSQL 접속 정보 (values.yaml postgresql.enabled: false, 공유 DB: database ns)
  AUTHENTIK_POSTGRESQL__HOST: "postgres.database.svc.cluster.local"
  AUTHENTIK_POSTGRESQL__PORT: "5432"
  AUTHENTIK_POSTGRESQL__NAME: "change-me"
  AUTHENTIK_POSTGRESQL__USER: "change-me"
  AUTHENTIK_POSTGRESQL__PASSWORD: "change-me"
  # 선택: 최초 기동 시 akadmin 비밀번호 / API 토큰 / 이메일 자동 설정 (최초 설치 때만 적용)
  # AUTHENTIK_BOOTSTRAP_PASSWORD: "change-me"
  # AUTHENTIK_BOOTSTRAP_TOKEN: "change-me"
  # AUTHENTIK_BOOTSTRAP_EMAIL: "change-me"
  # 선택: 메일 발송(SMTP)
  # AUTHENTIK_EMAIL__HOST: "change-me"
  # AUTHENTIK_EMAIL__PORT: "587"
  # AUTHENTIK_EMAIL__USERNAME: "change-me"
  # AUTHENTIK_EMAIL__PASSWORD: "change-me"
  # AUTHENTIK_EMAIL__USE_TLS: "true"
  # AUTHENTIK_EMAIL__FROM: "change-me"
