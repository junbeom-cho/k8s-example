# =====================================================================
# Homarr — Secret 템플릿 (예시: 모든 민감값은 change-me)
# homarr-secret: 데이터베이스/암호화 보안 정보 (ENCRYPTION_KEY · DATABASE_PASSWORD · auth-secret)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
# 참고: Valkey 비밀번호 Secret valkey-auth (키 valkey-password) 는 values-valkey.yaml 의
#       valkey 차트가 자동 생성하므로 이 템플릿에 포함하지 않습니다.
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: homarr-secret
  namespace: homarr
type: Opaque
stringData:
  ENCRYPTION_KEY: 'change-me'
  DATABASE_PASSWORD: 'change-me'
  auth-secret: 'change-me'
