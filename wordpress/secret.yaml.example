# =====================================================================
# WordPress — Secret 템플릿 (예시: 모든 민감값은 change-me)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ※ minio-secret 은 방법 1 에서 minio/secret-sync.yaml.example 의 minio-secret-sync 가
#    이 ns 로 주입합니다. 방법 2 이면서 backup.enabled=true 일 때만 아래 minio-secret 문서도 적용하세요.
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: wordpress-secret
  namespace: wordpress
type: Opaque
stringData:
  ADMIN_PASSWORD: 'change-me'
  DATABASE_PASSWORD: 'change-me'
---
# S3 백업 (MinIO) — values.yaml 의 backup.s3.existingSecret (backup.enabled=true 일 때만 사용)
apiVersion: v1
kind: Secret
metadata:
  name: minio-secret
  namespace: wordpress
type: Opaque
stringData:
  ROOT_USER: 'change-me'
  ROOT_PASSWORD: 'change-me'
