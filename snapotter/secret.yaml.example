# =====================================================================
# SnapOtter — Secret 템플릿 (예시: 모든 민감값은 change-me)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
# ---------------------------------------------------------------------
# ⚠️ secret-sync 가 동작 중일 때 이 Secret 을 apply 하면 실값이 placeholder 로 덮인다
#    (다음 resync 까지 최대 60초). 최초 부트스트랩 외에는 apply 하지 말 것.
#
# ⚠️ URL 안에 들어가는 비밀번호는 URL 인코딩 필수.
#    @ : / ? # 등이 들어가면 접속이 깨진다. 영숫자로만 생성하는 편이 안전하다:
#      openssl rand -hex 32
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: snapotter-secret
  namespace: snapotter
  labels:
    app: snapotter
type: Opaque
stringData:
  # database ns 의 공용 postgres. DB/유저는 미리 생성해 둘 것 (snapotter_db / snapotter_user)
  DATABASE_URL: "postgres://snapotter_user:change-me@postgres.database.svc.cluster.local:5432/snapotter_db"

  # snapotter ns 전용 Valkey (Helm 릴리스 valkey → Service valkey-client).
  # 비밀번호는 아래 VALKEY_PASSWORD 와 반드시 동일해야 한다.
  # (Valkey 는 프로토콜 호환이라 redis:// 스킴 그대로 사용)
  REDIS_URL: "redis://:change-me@valkey-client.snapotter.svc.cluster.local:6379"

  # Valkey 차트가 auth.existingSecret 으로 읽어가는 키 (values-valkey.yaml).
  # REDIS_URL 안의 비밀번호와 같은 값이어야 한다.
  # ※ 단, 현재 values-valkey.yaml 의 auth.existingSecret 은 비어 있음(차트 기본값 → 비밀번호 자동 생성)
  #   → 재사용 시 existingSecret: snapotter-secret / existingSecretPasswordKey: VALKEY_PASSWORD 로 맞출 것 (values-valkey.yaml 헤더 참고).
  VALKEY_PASSWORD: "change-me"

  # 최초 admin 계정 비밀번호 (compose 기본값 'admin' 은 절대 사용 금지)
  DEFAULT_PASSWORD: "change-me"

  # 세션 쿠키 서명 키. 비워두면 재시작 때마다 세션이 무효화될 수 있다.
  COOKIE_SECRET: "change-me"
