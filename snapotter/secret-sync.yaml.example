# =====================================================================
# SnapOtter — Infisical 동기화 (InfisicalSecret)
# Infisical 프로젝트 "snapotter" (env: prod) 값을 snapotter-secret Secret 으로 주입합니다.
# 전제: Infisical secrets-operator 설치 + infisical ns 의 infisical-auth-token Secret
#       (infisical/secret.yaml.example 참고)
# 적용: kubectl apply -f secret-sync.yaml.example
# ---------------------------------------------------------------------
# 사전 준비
#   1) Infisical 에 projectSlug "snapotter" 프로젝트 생성, prod 환경에 키 등록
#      (키 목록은 secret.yaml.example 참고)
#   2) infisical-auth-token 머신 아이덴티티에 해당 프로젝트 읽기 권한 부여
#
# 확인
#   kubectl get infisicalsecret snapotter-secret-sync -n snapotter -o yaml   # status.conditions
#   kubectl get secret snapotter-secret -n snapotter -o json | jq -r '.data | keys[]'
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 secrets-operator 최신 버전(마지막 사용 0.11.0)과
#    InfisicalSecret CRD(secrets.infisical.com/v1alpha1) 스펙 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: secrets.infisical.com/v1alpha1
kind: InfisicalSecret
metadata:
  name: snapotter-secret-sync
  namespace: snapotter
spec:
  hostAPI: https://infisical.techbara.dev/api
  resyncInterval: 60
  authentication:
    universalAuth:
      secretsScope:
        projectSlug: "snapotter"
        envSlug: "prod"
        secretsPath: "/"
      credentialsRef:
        secretName: infisical-auth-token
        secretNamespace: infisical
  managedKubeSecretReferences:
    - secretName: snapotter-secret
      secretNamespace: snapotter
      secretType: Opaque
