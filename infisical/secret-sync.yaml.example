# =====================================================================
# Infisical — Infisical 동기화 (InfisicalSecret)
# Infisical 프로젝트 "infisical" / "resend" / "brevo" (env: prod) 값을
# infisical-secret / resend-secret / brevo-secret Secret 으로 주입합니다.
# 전제: Infisical secrets-operator 설치 + infisical ns 의 infisical-auth-token Secret
#       (infisical/secret.yaml.example 참고)
# 적용: kubectl apply -f secret-sync.yaml.example
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 secrets-operator 최신 버전(마지막 사용 0.11.0)과
#    InfisicalSecret CRD(secrets.infisical.com/v1alpha1) 스펙 변경 여부를 반드시 확인하세요.
# =====================================================================
# [1] infisical-secret-sync — Infisical 자체 설정(infisical-secret) 동기화
apiVersion: secrets.infisical.com/v1alpha1
kind: InfisicalSecret
metadata:
  name: infisical-secret-sync
  namespace: infisical
spec:
  hostAPI: https://infisical.techbara.dev/api
  resyncInterval: 60
  authentication:
    universalAuth:
      secretsScope:
        projectSlug: "infisical"
        envSlug: "prod"
        secretsPath: "/"
      credentialsRef:
        secretName: infisical-auth-token
        secretNamespace: infisical
  managedKubeSecretReferences:
    - secretName: infisical-secret
      secretNamespace: infisical
      secretType: Opaque
---
# [2] resend-secret-sync — 이전 SMTP 공급자(Resend) 자격 증명 fan-out (레거시)
#     리소스는 infisical ns 에 두고, 대상 Secret 은 사용하는 앱의 ns 에 생성합니다 (의도된 교차 ns 참조).
#     ※ 2026-06 에 SMTP 가 Resend → Brevo 로 전환된 뒤 resend-secret 을 읽는 설정은 없습니다
#       (karakeep ns 로만 배포, 미사용).
apiVersion: secrets.infisical.com/v1alpha1
kind: InfisicalSecret
metadata:
  name: resend-secret-sync
  namespace: infisical
spec:
  hostAPI: https://infisical.techbara.dev/api
  resyncInterval: 60
  authentication:
    universalAuth:
      secretsScope:
        projectSlug: "resend"
        envSlug: "prod"
        secretsPath: "/"
      credentialsRef:
        secretName: infisical-auth-token
        secretNamespace: infisical
  managedKubeSecretReferences:
    - secretName: resend-secret
      secretNamespace: karakeep
      secretType: Opaque
---
# [3] brevo-secret-sync — SMTP(Brevo) 자격 증명 fan-out (마지막 사용 시점의 실제 SMTP 공급자)
#     brevo-secret 키: karakeep / yuvomi / mealie 는 SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD,
#     vaultwarden 은 SMTP_PASSWORD 를 참조합니다.
apiVersion: secrets.infisical.com/v1alpha1
kind: InfisicalSecret
metadata:
  name: brevo-secret-sync
  namespace: infisical
spec:
  hostAPI: https://infisical.techbara.dev/api
  resyncInterval: 60
  authentication:
    universalAuth:
      secretsScope:
        projectSlug: "brevo"
        envSlug: "prod"
        secretsPath: "/"
      credentialsRef:
        secretName: infisical-auth-token
        secretNamespace: infisical
  managedKubeSecretReferences:
    - secretName: brevo-secret
      secretNamespace: karakeep
      secretType: Opaque
    - secretName: brevo-secret
      secretNamespace: vaultwarden
      secretType: Opaque
    - secretName: brevo-secret
      secretNamespace: yuvomi
      secretType: Opaque
    - secretName: brevo-secret
      secretNamespace: mealie
      secretType: Opaque
