# =====================================================================
# Karakeep — Secret 템플릿 (예시: 모든 민감값은 change-me)
# 내용: NextAuth 세션 secret · Meilisearch master key (+ 방법 2 전용 brevo-secret SMTP 정보)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ※ brevo-secret 은 방법 1 에서 infisical/secret-sync.yaml.example 의 brevo-secret-sync 가
#    이 ns 로 주입합니다. 방법 2 일 때만 아래 brevo-secret 문서도 값 수정 후 함께 적용하세요.
#    (minio-secret·resend-secret 도 minio/·infisical/ 에서 이 ns 로 동기화되지만 현재 values 에서는 미사용)
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: karakeep-secret
  namespace: karakeep
type: Opaque
stringData:
  # 키 이름은 values.yaml 의 existingSecretNextAuthKey / existingSecretMeiliMasterKey 와 일치해야 함
  NEXTAUTH_SECRET: "change-me"
  MEILI_MASTER_KEY: "change-me"
---
# SMTP (Brevo) — values.yaml 의 karakeep.extraEnv secretKeyRef
apiVersion: v1
kind: Secret
metadata:
  name: brevo-secret
  namespace: karakeep
type: Opaque
stringData:
  SMTP_HOST: "smtp-relay.brevo.com"
  SMTP_PORT: "587"
  SMTP_USER: "change-me"
  SMTP_PASSWORD: "change-me"
