# =====================================================================
# Mealie — Infisical 동기화 (InfisicalSecret)
# Infisical 프로젝트 "mealie" (env: prod) 값을 mealie-secret Secret 으로 주입합니다.
# 전제: Infisical secrets-operator 설치 + infisical ns 의 infisical-auth-token Secret
#       (infisical/secret.yaml.example 참고)
# 적용: kubectl apply -f secret-sync.yaml.example
# 참고: brevo-secret(SMTP)은 여기서 동기화하지 않습니다. infisical/secret-sync.yaml.example 의
#       brevo-secret-sync(fan-out)가 mealie ns 로 주입합니다.
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 secrets-operator 최신 버전(마지막 사용 0.11.0)과
#    InfisicalSecret CRD(secrets.infisical.com/v1alpha1) 스펙 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: secrets.infisical.com/v1alpha1
kind: InfisicalSecret
metadata:
  name: mealie-secret-sync
  namespace: mealie
spec:
  hostAPI: https://infisical.techbara.dev/api
  resyncInterval: 60
  authentication:
    universalAuth:
      secretsScope:
        projectSlug: "mealie"
        envSlug: "prod"
        secretsPath: "/"
      credentialsRef:
        secretName: infisical-auth-token
        secretNamespace: infisical
  managedKubeSecretReferences:
    - secretName: mealie-secret
      secretNamespace: mealie
      secretType: Opaque
