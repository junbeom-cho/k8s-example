# =====================================================================
# Mealie — Secret 템플릿 (예시: 모든 민감값은 change-me)
#   - mealie-secret : 데이터베이스 보안 정보 (PostgreSQL 접속 정보 → mealie.yaml 의 POSTGRES_*)
#   - brevo-secret  : SMTP(Brevo) 메일 발송 정보 (→ mealie.yaml 의 SMTP_*)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
#         (brevo-secret 은 infisical/secret-sync.yaml.example 의 brevo-secret-sync 가 주입)
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: mealie-secret
  namespace: mealie
type: Opaque
stringData:
  POSTGRES_USER: "change-me"
  POSTGRES_PASSWORD: "change-me"
  POSTGRES_DB: "change-me"
  POSTGRES_PORT: "change-me"   # 예: 5432
  POSTGRES_HOST: "change-me"   # 예: postgres.database.svc.cluster.local (database ns 공용 PostgreSQL)

---
apiVersion: v1
kind: Secret
metadata:
  name: brevo-secret
  namespace: mealie
type: Opaque
stringData:
  SMTP_HOST: "smtp-relay.brevo.com"
  SMTP_PORT: "587"
  SMTP_USER: "change-me"
  SMTP_PASSWORD: "change-me"
