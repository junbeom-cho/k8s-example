# =====================================================================
# Hoppscotch — Secret 템플릿 (예시: 모든 민감값은 change-me)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
# 참고: WEBAPP_SERVER_SIGNING_KEY 는 차트가 자체 Secret(hoppscotch)에 자동 생성하므로
#       (values.yaml signingKey.existingSecret 비움) 이 템플릿에 포함하지 않습니다.
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: hoppscotch-secret
  namespace: hoppscotch
type: Opaque
stringData:
  # values.yaml encryption.existingSecretKey — 정확히 32자, 최초 설치 후 변경 금지
  DATA_ENCRYPTION_KEY: "change-me"
  # values.yaml database.external.existingSecretUrlKey — 전체 PostgreSQL 접속 URL
  DATABASE_URL: "postgresql://hoppscotch_user:change-me@postgres.database.svc.cluster.local:5432/hoppscotch_db"
  # values.yaml mailer.existingSecretSmtpUrlKey — mailer.useCustomConfigs: false 일 때 사용
  SMTP_URL: "smtp://change-me:change-me@smtp-relay.brevo.com:587"
  # values.yaml mailer.existingSecretPasswordKey — mailer.useCustomConfigs: true 일 때 사용
  SMTP_PASSWORD: "change-me"
