# =====================================================================
# CrowdSec — Secret 템플릿 (예시: 모든 민감값은 change-me)
# 방법 1) Infisical: secret-sync.yaml.example 적용 → Infisical 값이 이 Secret 으로 주입됨
# 방법 2) 수동: cp secret.yaml.example secret.yaml → 값 수정 → kubectl apply -f secret.yaml
# ⚠️ 실제 값을 채운 secret.yaml 은 커밋하지 마세요 (.gitignore 처리됨)
# ⚠️ 마지막 사용 시점 기준 설정입니다. 다음에 사용할 때는 앱/차트 최신 버전과
#    Secret 키 이름·형식 변경 여부를 반드시 확인하세요.
# =====================================================================
# crowdsec-secret — values.yaml(lapi.env)와 crowdsec-traefik-bouncer.yaml 이 참조
#   ※ values.yaml config.yaml.local 의 ${REGISTRATION_TOKEN} 은 차트가 자동 생성/관리하는
#     값이라 여기에 넣지 않습니다.
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-secret
  namespace: crowdsec
type: Opaque
stringData:
  # CrowdSec Console 등록(enroll) 키 → lapi 의 ENROLL_KEY
  ENROLL_KEY: "change-me"
  # 공유 PostgreSQL(postgres.database.svc.cluster.local) crowdsec_user 비밀번호 → lapi 의 DB_PASSWORD
  DB_PASSWORD: "change-me"
  # Traefik bouncer API 키 → lapi 의 BOUNCER_KEY_traefik(등록) + bouncer 의 CROWDSEC_BOUNCER_API_KEY
  BOUNCER_API_KEY: "change-me"
